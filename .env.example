APP_NAME="Family education"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
ACCOUNT_DELETION_ENABLED=false
APP_URL=http://localhost:8081

WWWUSER=1000
WWWGROUP=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=family_education
DB_USERNAME=family_education
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Temporary appeal contact; replace with a monitored mailbox before release.
MODERATION_APPEAL_EMAIL=family-education@help.ru

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Cloudflare Turnstile. For local development, the application falls back to
# Cloudflare's official test keys. Set real keys in staging and production.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=http://telegram-proxy:10808

# Independent deletion registry: provision only in the selected VPS environment.
ACCOUNT_DELETION_REGISTRY_DRIVER=unavailable
ACCOUNT_DELETION_REGISTRY_NAMESPACE=
DELETION_REGISTRY_HOST=
DELETION_REGISTRY_PORT=5432
DELETION_REGISTRY_DATABASE=
DELETION_REGISTRY_USERNAME=
DELETION_REGISTRY_PASSWORD=
DELETION_REGISTRY_SSLMODE=require
ACCOUNT_DELETION_REDIS_QUEUES=default

MAX_ENABLED=false
MAX_BOT_ID=
MAX_BOT_USERNAME=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_CA_BUNDLE=
